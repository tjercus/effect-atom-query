{
  "name": "effect-atom-query",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://tjercus.github.io/effect-atom-query/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjercus/effect-atom-query.git"
  },
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build && vp run size",
    "dev": "vp run playground#dev",
    "dev:flights": "vp run flight-dashboard#dev",
    "prepare": "vp config",
    "size": "vpx ./scripts/size.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && vp install",
    "release:check": "vp run -r build && pnpm -r --filter \"./packages/*\" publish --dry-run --no-git-checks",
    "release:guard": "vpx ./scripts/release-guard.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
