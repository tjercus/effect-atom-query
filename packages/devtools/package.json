{
  "name": "@effect-atom-query/devtools",
  "version": "1.1.0",
  "description": "In-app devtools panel for @effect-atom-query (query and mutation cache inspector).",
  "keywords": [
    "devtools",
    "effect",
    "effect-ts",
    "query",
    "react"
  ],
  "homepage": "https://github.com/tjercus/effect-atom-query/tree/main/packages/devtools#readme",
  "bugs": {
    "url": "https://github.com/tjercus/effect-atom-query/issues"
  },
  "license": "MIT",
  "author": "tjercus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjercus/effect-atom-query.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@effect-atom-query/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --coverage",
    "check": "vp check"
  },
  "devDependencies": {
    "@effect-atom-query/query": "workspace:^",
    "@effect-atom-query/react": "workspace:^",
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect-atom-query/query": "workspace:^",
    "@effect-atom-query/react": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "^19.0.0"
  }
}
