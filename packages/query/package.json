{
  "name": "@effect-atom-query/query",
  "version": "1.2.1",
  "description": "Server-state caching on Effect and Effect Atoms, in the style of TanStack Query.",
  "keywords": [
    "atom",
    "cache",
    "effect",
    "effect-ts",
    "query",
    "server-state",
    "tanstack-query"
  ],
  "homepage": "https://github.com/tjercus/effect-atom-query/tree/main/packages/query#readme",
  "bugs": {
    "url": "https://github.com/tjercus/effect-atom-query/issues"
  },
  "license": "MIT",
  "author": "tjercus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjercus/effect-atom-query.git",
    "directory": "packages/query"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@effect-atom-query/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --coverage",
    "check": "vp check"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
