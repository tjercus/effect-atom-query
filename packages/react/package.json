{
  "name": "@effect-atom-query/react",
  "version": "0.0.0",
  "description": "React hooks for @effect-atom-query/query: useQuery, useMutation, Suspense, infinite queries.",
  "keywords": [
    "atom",
    "effect",
    "effect-ts",
    "hooks",
    "query",
    "react",
    "server-state",
    "suspense"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@effect-atom-query/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@effect-atom-query/query": "workspace:^"
  },
  "devDependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  }
}
